static int tft35_write_cmd(struct tft35 *ctx, u8 cmd)
{
    int ret;

    gpiod_set_value_cansleep(ctx->dc_gpio, 0);

    ret = spi_write(ctx->spi, &cmd, sizeof(cmd));
    if (ret)
        dev_err(ctx->dev,
                "tft35_write_cmd failed: %d\n",
                ret);

    return ret;
}

static int tft35_write_data(struct tft35 *ctx,
                            const u8 *data,
                            size_t data_length)
{
    int ret;

    gpiod_set_value_cansleep(ctx->dc_gpio, 1);

    ret = spi_write(ctx->spi, data, data_length);
    if (ret)
        dev_err(ctx->dev,
                "tft35_write_data failed: %d\n",
                ret);

    return ret;
}

static int tft35_write_cmd_data(struct tft35 *ctx,
                                u8 cmd,
                                const u8 *data,
                                size_t data_length)
{
    int ret;

    ret = tft35_write_cmd(ctx, cmd);
    if (ret)
        return ret;

    return tft35_write_data(ctx, data, data_length);
}

static int tft35_write_data16(struct tft35 *ctx, u16 value)
{
    u8 buf[2];

    /*
     * TFT protocol expects big-endian bytes.
     *
     * Example:
     * 479 = 0x01DF
     *
     * transmitted as:
     * 01 DF
     */
    buf[0] = value >> 8;
    buf[1] = value & 0xff;

    return tft35_write_data(ctx, buf, sizeof(buf));
}

static void tft35_fill_color(struct tft35 *ctx, u16 color)
{
    int x, y;

    // Set column address
    tft35_write_cmd(ctx, 0x2A);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, 319);

    // Set row address 
    tft35_write_cmd(ctx, 0x2B);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, 479);

    // Memory write
    tft35_write_cmd(ctx, 0x2C);

    for (y = 0; y < 480; y++)
        for (x = 0; x < 320; x++)
            tft35_write_data16(ctx, color);
}

static void tft35_test_pattern(struct tft35 *ctx)
{
    int x, y;
    u16 color;

    /*
     * Native ILI9486 GRAM geometry:
     *
     * 320 columns
     * 480 rows
     */

    tft35_write_cmd(ctx, 0x2A);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, 319);

    tft35_write_cmd(ctx, 0x2B);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, 479);

    tft35_write_cmd(ctx, 0x2C);

    for (y = 0; y < 480; y++) {
        for (x = 0; x < 320; x++) {

            if (x < 160 && y < 240)
                color = 0xF800;   /* red */

            else if (x >= 160 && y < 240)
                color = 0x07E0;   /* green */

            else if (x < 160)
                color = 0x001F;   /* blue */

            else
                color = 0xFFFF;   /* white */

            tft35_write_data16(ctx, color);
        }
    }
}

static int tft35_write_buffer(struct tft35 *ctx,
                              const void *buf,
                              size_t len)
{
    const u8 *p = buf;
    const size_t chunk_size = 16 * 1024;
    size_t sent = 0;
    int ret;

    gpiod_set_value_cansleep(ctx->dc_gpio, 1);

    while (sent < len) {
        size_t this_len;
        struct spi_transfer transfer = {
            .bits_per_word = 8,
        };

        this_len = min_t(size_t,
                         chunk_size,
                         len - sent);

        transfer.tx_buf = p + sent;
        transfer.len = this_len;

        ret = spi_sync_transfer(ctx->spi,
                                &transfer,
                                1);

        if (ret) {
            dev_err(ctx->dev,
                    "pixel SPI transfer failed "
                    "at %zu/%zu: %d\n",
                    sent,
                    len,
                    ret);
            return ret;
        }

        sent += this_len;
    }

    return 0;
}

static int tft35_spi_write_pixels(struct tft35 *ctx, void *buf, int width, int height)
{
    int ret;
    /* Set window (column + row address) */
    tft35_write_cmd(ctx, 0x2A);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, width - 1);

    tft35_write_cmd(ctx, 0x2B);
    tft35_write_data16(ctx, 0);
    tft35_write_data16(ctx, height - 1);

    // Memory write
    tft35_write_cmd(ctx, 0x2C);

    /* Send pixel buffer */
    size_t len = width * height * 2;
    ret = tft35_write_buffer(ctx, buf, len);
    return ret;
}

int tft35_display_init(struct tft35 *ctx)
{
    int ret = 0;

    uint8_t cmdC0[] = {0x0F, 0x0F};
    uint8_t cmdC1[] = {0x41};
    uint8_t cmdC5[] = {0x00, 0x91, 0x80, 0x00};
    uint8_t cmd36[] = {0x48};
    uint8_t cmd3A[] = {0x55};
    uint8_t cmdB1[] = {0xB0};
    uint8_t cmdB4[] = {0x02};
    uint8_t cmdB6[] = {0x02, 0x02};
    uint8_t cmdE0[] = {
        0x0F, 0x1F, 0x1C, 0x0C, 0x0F, 0x08, 0x48, 0x98,
        0x37, 0x0A, 0x13, 0x04, 0x11, 0x0D, 0x00
    };
    uint8_t cmdE1[] = {
        0x0F, 0x32, 0x2E, 0x0B, 0x0D, 0x05, 0x47, 0x75,
        0x37, 0x06, 0x10, 0x03, 0x24, 0x20, 0x00
    };

    tft35_write_cmd_data(ctx, 0xC0, cmdC0, ARRAY_SIZE(cmdC0));
    tft35_write_cmd_data(ctx, 0xC1, cmdC1, ARRAY_SIZE(cmdC1));
    tft35_write_cmd_data(ctx, 0xC5, cmdC5, ARRAY_SIZE(cmdC5));

    tft35_write_cmd_data(ctx, 0x36, cmd36, ARRAY_SIZE(cmd36));
    tft35_write_cmd_data(ctx, 0x3A, cmd3A, ARRAY_SIZE(cmd3A));

    tft35_write_cmd_data(ctx, 0xB1, cmdB1, ARRAY_SIZE(cmdB1));
    tft35_write_cmd_data(ctx, 0xB4, cmdB4, ARRAY_SIZE(cmdB4));
    tft35_write_cmd_data(ctx, 0xB6, cmdB6, ARRAY_SIZE(cmdB6));

    tft35_write_cmd_data(ctx, 0xE0, cmdE0, ARRAY_SIZE(cmdE0));
    tft35_write_cmd_data(ctx, 0xE1, cmdE1, ARRAY_SIZE(cmdE1));

    tft35_write_cmd(ctx, 0x11);
    msleep(120);

    ret = tft35_write_cmd(ctx, 0x29);
    msleep(20);

    return ret;
}


