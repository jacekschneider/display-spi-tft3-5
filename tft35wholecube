static void convert_line_xrgb8888_to_rgb565_be(u8 *dst,
                                               const u8 *src,
                                               unsigned int width,
                                               bool swap_rb)
{
    unsigned int x;

    for (x = 0; x < width; x++) {
        u32 px;
        u8 r, g, b;
        u16 rgb565;

        memcpy(&px, src + x * 4, sizeof(px));

        r = (px >> 16) & 0xff;
        g = (px >> 8) & 0xff;
        b = px & 0xff;

        if (swap_rb) {
            u8 tmp = r;

            r = b;
            b = tmp;
        }

        rgb565 = ((r & 0xf8) << 8) |
                 ((g & 0xfc) << 3) |
                 (b >> 3);

        /* Big-endian RGB565 for SPI */
        dst[x * 2 + 0] = (rgb565 >> 8) & 0xff;
        dst[x * 2 + 1] = rgb565 & 0xff;
    }
}

static void copy_line_rgb565_to_be(u8 *dst,
                                   const u8 *src,
                                   unsigned int width)
{
    unsigned int x;

    for (x = 0; x < width; x++) {
        u16 px;

        memcpy(&px, src + x * 2, sizeof(px));

        dst[x * 2 + 0] = (px >> 8) & 0xff;
        dst[x * 2 + 1] = px & 0xff;
    }
}

static void tft35_pipe_update(struct drm_simple_display_pipe *pipe,
                              struct drm_plane_state *old_plane_state)
{
    struct tft35 *ctx = container_of(pipe, struct tft35, dsdp);
    struct drm_plane_state *pstate = pipe->plane.state;
    struct drm_framebuffer *fb;
    struct drm_rect src_rect;

    struct iosys_map map[DRM_FORMAT_MAX_PLANES];
    struct iosys_map data[DRM_FORMAT_MAX_PLANES];

    unsigned int src_stride;
    unsigned int dst_stride;
    unsigned int src_x;
    unsigned int src_y;
    unsigned int y;

    int bpp_bytes;
    int w;
    int h;
    int ret;

    size_t required_len;

    const u8 *src_base;
    u8 *dst_base;

    bool swap_rb;

    (void)old_plane_state;

    if (!pstate)
        return;

    fb = pstate->fb;
    if (!fb)
        return;

    src_rect = pstate->src;

    w = (src_rect.x2 - src_rect.x1) >> 16;
    h = (src_rect.y2 - src_rect.y1) >> 16;

    if (w <= 0 || h <= 0)
        return;

    switch (fb->format->format) {
    case DRM_FORMAT_XRGB8888:
    case DRM_FORMAT_ARGB8888:
    case DRM_FORMAT_XBGR8888:
    case DRM_FORMAT_ABGR8888:
        bpp_bytes = 4;
        break;

    case DRM_FORMAT_RGB565:
        bpp_bytes = 2;
        break;

    default:
        pr_err("tft35: unsupported format 0x%08x\n",
               fb->format->format);
        return;
    }

    src_stride = fb->pitches[0];
    dst_stride = w * 2;

    required_len = (size_t)dst_stride * h;

    if (!ctx->tx_buf)
        return;

    if (required_len > ctx->tx_buf_size) {
        pr_err("tft35: tx buffer too small: %zu > %zu\n",
               required_len,
               ctx->tx_buf_size);
        return;
    }

    /*
     * Important for buffers produced by the GPU / imported DMA-BUF.
     */
    ret = drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE);
    if (ret) {
        pr_err("tft35: begin_cpu_access failed: %d\n", ret);
        return;
    }

    memset(map, 0, sizeof(map));
    memset(data, 0, sizeof(data));

    /*
     * Generic GEM framebuffer mapping.
     *
     * 'data' already includes fb->offsets[].
     */
    ret = drm_gem_fb_vmap(fb, map, data);
    if (ret) {
        pr_err("tft35: drm_gem_fb_vmap failed: %d\n", ret);
        goto out_cpu_access;
    }

    if (iosys_map_is_null(&data[0])) {
        pr_err("tft35: framebuffer mapping is NULL\n");
        goto out_unmap;
    }

    src_x = src_rect.x1 >> 16;
    src_y = src_rect.y1 >> 16;

    /*
     * drm_gem_fb_vmap(..., data) already applies
     * fb->offsets[0], so DON'T add it again here.
     */
    src_base =
        data[0].vaddr +
        (size_t)src_y * src_stride +
        (size_t)src_x * bpp_bytes;

    dst_base = ctx->tx_buf;

    swap_rb =
        fb->format->format == DRM_FORMAT_XBGR8888 ||
        fb->format->format == DRM_FORMAT_ABGR8888;

    pr_debug(
        "tft35: fb=%u fmt=%p4cc "
        "modifier=0x%016llx "
        "w=%d h=%d "
        "pitch=%u dst_stride=%u "
        "src_x=%u src_y=%u "
        "imported=%d\n",
        fb->base.id,
        &fb->format->format,
        (unsigned long long)fb->modifier,
        w,
        h,
        src_stride,
        dst_stride,
        src_x,
        src_y,
        drm_gem_is_imported(drm_gem_fb_get_obj(fb, 0)));

    for (y = 0; y < h; y++) {
        const u8 *src_line =
            src_base + (size_t)y * src_stride;

        u8 *dst_line =
            dst_base + (size_t)y * dst_stride;

        if (bpp_bytes == 4) {
            convert_line_xrgb8888_to_rgb565_be(
                dst_line,
                src_line,
                w,
                swap_rb);
        } else {
            copy_line_rgb565_to_be(
                dst_line,
                src_line,
                w);
        }
    }

    ret = tft35_spi_write_pixels(ctx,
                                 ctx->tx_buf,
                                 w,
                                 h);

    if (ret)
        pr_err("tft35: SPI framebuffer write failed: %d\n",
               ret);

out_unmap:
    drm_gem_fb_vunmap(fb, map);

out_cpu_access:
    drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
}

