/dts-v1/;
/plugin/;

/{
    fragment@2 {
        target=<&spi0>;
        __overlay__ {
            
            tft35display@0 {
                compatible = "schneider,tft35display";
                reg = <0>; /* CS=0 */
                spi-max-frequency = <32000000>;

                dc-gpios = <&gpio 16 2>; /* instruction/data register selection (data command) */
                reset-gpios = <&gpio 20 2>; /* panel reset */

                status = "okay";
            };
        };
    };

};